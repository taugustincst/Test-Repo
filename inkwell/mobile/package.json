{
  "name": "inkwell-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Native iOS and Android shell for Inkwell, built with Capacitor",
  "scripts": {
    "configure": "node configure.js",
    "add:android": "npm run configure && cap add android && cap sync android",
    "add:ios": "npm run configure && cap add ios && cap sync ios",
    "sync": "npm run configure && cap sync",
    "open:android": "cap open android",
    "open:ios": "cap open ios",
    "run:android": "cap run android",
    "run:ios": "cap run ios",
    "doctor": "cap doctor"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@capacitor/push-notifications": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0"
  }
}
