# Copy to .env and fill in. Every value is optional in development; the marked ones matter in production.

NODE_ENV=production
PORT=3000
APP_URL=https://inkwell.example.com          # required in production: email links, share previews, Stripe return URLs
TRUST_PROXY=1                                # set when behind nginx / a load balancer / a PaaS router

# Storage (the Docker image mounts /data)
INKWELL_DB_PATH=/data/inkwell.db
INKWELL_UPLOAD_DIR=/data/uploads
INKWELL_SKIP_SEED=1                          # never auto-seed demo accounts in production

# Email (one of the two blocks). Without it, mail is only logged.
SMTP_URL=smtp://user:password@smtp.example.com:587
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=user
# SMTP_PASS=password
# SMTP_SECURE=0
MAIL_FROM="Inkwell <hello@inkwell.example.com>"

# Payments. Without STRIPE_SECRET_KEY the demo card processor runs and no money moves.
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...              # from the webhook endpoint pointing at /api/payments/webhook/stripe
STRIPE_CURRENCY=usd
INKWELL_REFUND_WINDOW_HOURS=48

# First admin: this existing account is granted admin on startup
INKWELL_ADMIN_EMAIL=you@example.com

# Logging
LOG_FORMAT=json

# Mobile: push notifications and native apps
# VAPID keys for web push. Generate once with: node -e "console.log(require('web-push').generateVAPIDKeys())"
# If unset, keys are generated and stored in the database (fine for a single instance).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT=mailto:hello@inkwell.example.com
# Firebase service account JSON (inline or a file path) for native iOS/Android push through FCM
FCM_SERVICE_ACCOUNT_JSON=
# Extra origins allowed to call the API with credentials (comma separated); the Capacitor shell origins are built in
CORS_ORIGINS=
# Deep links: serve /.well-known association files for the store apps
ANDROID_PACKAGE=com.inkwell.app
ANDROID_CERT_SHA256=
IOS_TEAM_ID=
IOS_BUNDLE_ID=com.inkwell.app
