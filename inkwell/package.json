{
  "name": "inkwell",
  "version": "1.1.0",
  "description": "A social platform for tattoo artists to share galleries, find clients, and book appointments",
  "main": "server/index.js",
  "private": true,
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "seed": "node server/seed.js",
    "test": "node --test test/*.test.js",
    "check": "node -e \"require('./server/index'); console.log('boot ok')\"",
    "backup": "node scripts/backup.js",
    "make-admin": "node scripts/make-admin.js",
    "docker:build": "docker build -t inkwell .",
    "docker:run": "docker run --rm -p 3000:3000 --env-file .env -v inkwell-data:/data inkwell"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.0.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.6",
    "express": "^4.19.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^9.1.1",
    "sharp": "^0.35.4"
  }
}
